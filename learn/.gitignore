# --- Azure Speech config -----------------------------------------------------
# Holds only resource IDs + region + tenant (NOT secrets); real auth is an
# ephemeral Entra token from `az login`. Still belongs OUTSIDE the repo.
*.env
config.env

# --- Segoe UI (licensed, NOT redistributable) --------------------------------
# Each machine regenerates its own WOFF2 from its local Windows install:
#   py tools/sync_fonts.py --css
# CI / non-Windows renders use Selawik (SIL OFL, metric-compatible) -- see the
# learn-ilt frame preset. Never commit these.
fonts/*.woff2
fonts/fonts.css

# --- Regenerable icon catalog index ------------------------------------------
#   py tools/icon_index.py build
assets/icon-index.json

# --- Render artefacts produced inside project folders ------------------------
*.mp4
*.wav

# EXCEPTION: the AI disclosure end card is a MANDATORY shared asset -- every
# Learn video must end with it, and a missing disclosure is a rubric
# disqualifier. The blanket *.mp4 above would otherwise exclude it.
!assets/AI_End_Card.mp4

# --- Regenerable run artefacts (recreated on the next tool run) ---------------
# Python bytecode cache, and the audition_voices.py voice cache.
__pycache__/
.voice-catalog.json

# --- Generated gallery (built from releases by build_gallery.py -> Pages) ------
gallery/

# --- published videos: source tracked on main, MP4/thumbnail go to a Release ---
!output/
output/*

# published: Require-MFA-With-A-Conditional-Access-Policy
!output/Require-MFA-With-A-Conditional-Access-Policy/
!output/Require-MFA-With-A-Conditional-Access-Policy/**
# Keep only source text + this video's own media screenshots. Everything below is a
# Release asset, a shared repo asset (re-copied at build), or a regenerable artifact.
output/Require-MFA-With-A-Conditional-Access-Policy/_snap*/
output/Require-MFA-With-A-Conditional-Access-Policy/snapshots/
output/Require-MFA-With-A-Conditional-Access-Policy/renders/
output/Require-MFA-With-A-Conditional-Access-Policy/fonts/
output/Require-MFA-With-A-Conditional-Access-Policy/anchors.js
output/Require-MFA-With-A-Conditional-Access-Policy/**/*.mp4
output/Require-MFA-With-A-Conditional-Access-Policy/**/*.wav
output/Require-MFA-With-A-Conditional-Access-Policy/*_thumbnail.png
output/Require-MFA-With-A-Conditional-Access-Policy/assets/grounds/
output/Require-MFA-With-A-Conditional-Access-Policy/assets/vendor/

# --- videos: source + render inputs tracked, outputs go to a Release ---
!output/
output/*

# video: What-Is-A-Container
!output/What-Is-A-Container/
!output/What-Is-A-Container/**
# INPUTS (narration.wav, end card, grounds — LFS-tracked) stay so the renderer has them;
# OUTPUTS + QA artifacts never enter git (the deliverable MP4/captions/thumbnail -> Release).
output/What-Is-A-Container/fonts/
output/What-Is-A-Container/renders/
output/What-Is-A-Container/_snap*/
output/What-Is-A-Container/snapshots/
output/What-Is-A-Container/anchors.js
output/What-Is-A-Container/What-Is-A-Container.mp4
output/What-Is-A-Container/What-Is-A-Container_thumbnail.png

# video: Highway-12-A-Lewis-And-Clark-Road-Trip-To-Montana
!output/Highway-12-A-Lewis-And-Clark-Road-Trip-To-Montana/
!output/Highway-12-A-Lewis-And-Clark-Road-Trip-To-Montana/**
# INPUTS (narration.wav, end card, grounds — LFS-tracked) stay so the renderer has them;
# OUTPUTS + QA artifacts never enter git (the deliverable MP4/captions/thumbnail -> Release).
output/Highway-12-A-Lewis-And-Clark-Road-Trip-To-Montana/fonts/
output/Highway-12-A-Lewis-And-Clark-Road-Trip-To-Montana/renders/
output/Highway-12-A-Lewis-And-Clark-Road-Trip-To-Montana/_snap*/
output/Highway-12-A-Lewis-And-Clark-Road-Trip-To-Montana/snapshots/
output/Highway-12-A-Lewis-And-Clark-Road-Trip-To-Montana/anchors.js
output/Highway-12-A-Lewis-And-Clark-Road-Trip-To-Montana/Highway-12-A-Lewis-And-Clark-Road-Trip-To-Montana.mp4
output/Highway-12-A-Lewis-And-Clark-Road-Trip-To-Montana/Highway-12-A-Lewis-And-Clark-Road-Trip-To-Montana_thumbnail.png
